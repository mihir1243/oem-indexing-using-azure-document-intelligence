        <mxCell id="step_embed" value="Embedder (OpenAI)&#xa;&#xa;text-embedding-3-small&#xa;Batch embed chunk_content&#xa;→ content_vector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="lane1">
