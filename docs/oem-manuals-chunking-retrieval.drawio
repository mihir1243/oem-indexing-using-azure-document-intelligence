        <mxCell id="script_index" value="scripts/index_manuals.py&#xa;pipeline.index_folder" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane1">
