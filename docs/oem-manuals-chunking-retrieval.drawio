        </mxCell>

        <mxCell id="store_md" value="Markdown cache&#xa;{stem}.md&#xa;{stem}.page_map.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
