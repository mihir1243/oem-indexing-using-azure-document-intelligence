        <mxCell id="hc_e6" value="table" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="chunk_lane" source="hc_branch" target="hc_table">
