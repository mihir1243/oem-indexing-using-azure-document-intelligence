        </mxCell>

        <mxCell id="step_extract" value="load_or_extract&#xa;&#xa;• Cached .md + page_map?&#xa;  → skip Azure DI&#xa;• Else Document Intelligence&#xa;  → markdown + page map&#xa;• Save under extracted/markdown/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="lane1">
          <mxGeometry x="250" y="100" width="220" height="140" as="geometry" />
