          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="lane1" source="step_extract" target="hc_in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="lane1" source="hc_emit" target="step_embed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="lane1" source="step_embed" target="step_docs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="lane1" source="step_docs" target="step_delete">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="lane1" source="step_delete" target="step_upload">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="lane1" source="step_upload" target="idx_store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Section 2: Retrieval -->
        <mxCell id="lane2" value="2. Retrieval Pipeline" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;startSize=36;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1720" height="620" as="geometry" />
        </mxCell>

        <mxCell id="in_query" value="User / CLI query&#xa;scripts/search_manuals.py" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="40" y="80" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="in_filters" value="Optional filters&#xa;manufacturer, manual_type,&#xa;model / model_series" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="lane2">
          <mxGeometry x="40" y="170" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="retriever" value="ManualRetriever.search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="lane2">
          <mxGeometry x="300" y="100" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="q_embed" value="embed_query (OpenAI)&#xa;Same model / dimensions&#xa;as indexing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="lane2">
          <mxGeometry x="530" y="70" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="build_filt" value="build_filter&#xa;OData expressions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="lane2">
          <mxGeometry x="530" y="190" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="search_lane" value="Azure AI Search — hybrid retrieval + semantic ranker (service-side)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;startSize=32;horizontal=0;" vertex="1" parent="lane2">
          <mxGeometry x="760" y="48" width="720" height="540" as="geometry" />
        </mxCell>

        <mxCell id="as_req" value="SearchClient.search() request&#xa;(ManualRetriever)&#xa;&#xa;• search_text = user query (BM25 input)&#xa;• vector_queries[0]:&#xa;  fields = content_vector&#xa;  vector = OpenAI query embedding&#xa;  k = max(top_k, 50)&#xa;• filter = OData (if any)&#xa;• top = top_k&#xa;• select = id, chunk_content, raw_text,&#xa;  section_*, page_number, metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="search_lane">
          <mxGeometry x="20" y="50" width="240" height="175" as="geometry" />
        </mxCell>

        <mxCell id="as_filter" value="① Apply OData filter&#xa;Narrows index to matching docs only&#xa;(manufacturer, manual_type,&#xa; model_series/any)&#xa;→ smaller candidate pool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="search_lane">
          <mxGeometry x="290" y="55" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="as_hybrid_label" value="② Hybrid retrieval (parallel)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1" vertex="1" parent="search_lane">
          <mxGeometry x="290" y="165" width="200" height="25" as="geometry" />
        </mxCell>

        <mxCell id="as_lexical" value="Lexical branch&#xa;Full-text / BM25 on searchable fields&#xa;(e.g. chunk_content, titles, paths)&#xa;&#xa;Optional scoring profile&#xa;(USE_SCORING_PROFILE):&#xa;• field weights (section_title 3, path 2…)&#xa;• tag boost on section_tags&#xa;  scoring_parameters: boostTags-{tag}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="search_lane">
          <mxGeometry x="20" y="195" width="250" height="145" as="geometry" />
        </mxCell>

        <mxCell id="as_vector" value="Vector branch&#xa;HNSW k-nearest neighbors&#xa;on content_vector (1536-d)&#xa;Cosine similarity vs query vector&#xa;Returns top-k vector neighbors&#xa;(k ≥ max(top_k, 50) in this app)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="search_lane">
          <mxGeometry x="290" y="195" width="230" height="125" as="geometry" />
        </mxCell>

        <mxCell id="as_rrf" value="③ Reciprocal Rank Fusion (RRF)&#xa;Merge lexical + vector ranked lists&#xa;into one hybrid candidate set&#xa;(no single manual score yet —&#xa; service combines rank positions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;fontStyle=1" vertex="1" parent="search_lane">
          <mxGeometry x="540" y="195" width="160" height="110" as="geometry" />
        </mxCell>

        <mxCell id="as_sem_gate" value="USE_SEMANTIC_&#xa;SEARCH?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="search_lane">
          <mxGeometry x="540" y="330" width="110" height="70" as="geometry" />
        </mxCell>

        <mxCell id="as_semantic" value="④ Semantic ranker (L2)&#xa;query_type = semantic&#xa;semantic_configuration_name =&#xa;  oem-semantic-config&#xa;&#xa;Prioritized fields (index config):&#xa;• title → section_title&#xa;• content → chunk_content&#xa;• keywords → section_path,&#xa;  manufacturer, manual_type&#xa;&#xa;Re-ranks hybrid candidates with&#xa;a language model → @search.reranker_score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;fontStyle=1" vertex="1" parent="search_lane">
          <mxGeometry x="290" y="340" width="230" height="175" as="geometry" />
        </mxCell>

        <mxCell id="as_nosem" value="No semantic stage&#xa;Final ordering from hybrid&#xa;@search.score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="search_lane">
          <mxGeometry x="20" y="370" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="as_out" value="⑤ Return top_k documents&#xa;ManualRetriever maps score:&#xa;reranker_score if present, else @search.score&#xa;→ SearchResult[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;fontStyle=1" vertex="1" parent="search_lane">
