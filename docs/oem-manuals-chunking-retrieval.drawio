        <!-- Section 1: Chunking & Indexing -->
        <mxCell id="lane1" value="1. Chunking &amp; Indexing Pipeline" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;startSize=36;" vertex="1" parent="1">
