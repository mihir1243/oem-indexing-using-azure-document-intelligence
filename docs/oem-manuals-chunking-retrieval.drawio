        <mxCell id="chunk_lane" value="HierarchicalChunker (src/chunking/hierarchical.py)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;startSize=32;horizontal=0;" vertex="1" parent="lane1">
          <mxGeometry x="480" y="48" width="720" height="500" as="geometry" />
        </mxCell>

        <mxCell id="hc_in" value="Input: ExtractedDocument&#xa;• markdown_content&#xa;• page_map (char offset → page)&#xa;• metadata (manifest fields)&#xa;• manual_id_prefix = SHA256(filename)[:16]" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="chunk_lane">
          <mxGeometry x="20" y="50" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="hc_headers" value="① MarkdownHeaderTextSplitter&#xa;Headers: # h1, ## h2, ### h3, #### h4&#xa;strip_headers = false (headers stay in body)&#xa;→ one LangChain Document per header section" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="chunk_lane">
          <mxGeometry x="250" y="45" width="220" height="95" as="geometry" />
        </mxCell>

        <mxCell id="hc_context" value="② _section_context_from_metadata&#xa;chapter_title ← h1&#xa;section_title ← deepest of h4…h1&#xa;section_path ← &quot;h1 &gt; h2 &gt; h3 &gt; h4&quot; (non-empty parts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="chunk_lane">
          <mxGeometry x="500" y="45" width="200" height="95" as="geometry" />
        </mxCell>

        <mxCell id="hc_loop" value="For each header section (in order)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=2" vertex="1" parent="chunk_lane">
          <mxGeometry x="250" y="155" width="220" height="35" as="geometry" />
        </mxCell>

        <mxCell id="hc_segment" value="③ _split_table_and_text(section.page_content)&#xa;Scan lines: |…| rows = table run&#xa;Non-table lines = prose run&#xa;→ ordered (text, table) segments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="chunk_lane">
          <mxGeometry x="20" y="200" width="250" height="90" as="geometry" />
        </mxCell>

        <mxCell id="hc_branch" value="Segment&#xa;type?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="chunk_lane">
          <mxGeometry x="310" y="205" width="100" height="80" as="geometry" />
        </mxCell>

        <mxCell id="hc_table" value="Table path: _split_table&#xa;• Parse header row + |---| separator&#xa;• If whole table ≤ CHUNK_MAX tokens → one chunk&#xa;• Else split data rows; repeat header on each part&#xa;• Target body tokens = max(200, MAX − header − 16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="chunk_lane">
          <mxGeometry x="450" y="165" width="250" height="115" as="geometry" />
        </mxCell>

        <mxCell id="hc_text" value="Text path&#xa;• tiktoken cl100k_base token count&#xa;• If tokens ≤ CHUNK_MAX (default 1000) → keep as one piece&#xa;• Else RecursiveCharacterTextSplitter&#xa;  chunk_size = CHUNK_MAX, overlap = CHUNK_OVERLAP (128)&#xa;  separators: ¶¶, bullets, numbered lists, “. ”, newline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="chunk_lane">
          <mxGeometry x="450" y="295" width="250" height="130" as="geometry" />
        </mxCell>

        <mxCell id="hc_pieces" value="For each text piece (skip empty)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=2" vertex="1" parent="chunk_lane">
          <mxGeometry x="20" y="320" width="200" height="35" as="geometry" />
        </mxCell>

        <mxCell id="hc_offset" value="④ Locate in full markdown&#xa;_find_offset(markdown, raw_text, search_from)&#xa;→ char_offset (sequential scan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="chunk_lane">
          <mxGeometry x="20" y="375" width="230" height="75" as="geometry" />
        </mxCell>

        <mxCell id="hc_emit" value="⑤ Emit Chunk&#xa;raw_text = piece (no path prefix)&#xa;chunk_content = section_path + &quot;\n&quot; + raw_text (if path set)&#xa;page_number = page_for_offset(page_map, char_offset)&#xa;id = {prefix}_{chunk_index:06d}_{sha8}&#xa;metadata = manifest ManualMetadata&#xa;→ list[Chunk]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;fontStyle=1" vertex="1" parent="chunk_lane">
          <mxGeometry x="280" y="360" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="hc_note" value="Embedding input uses chunk_content (section path prepended for vector search context)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontStyle=2" vertex="1" parent="chunk_lane">
          <mxGeometry x="580" y="440" width="130" height="50" as="geometry" />
        </mxCell>

