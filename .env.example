AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=

AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=oem-manuals-index
# Enable only if this index has semantic search configured in Azure Portal
USE_SEMANTIC_SEARCH=false
SEMANTIC_CONFIGURATION_NAME=oem-semantic-config

# Scoring profile (add section_tags field + profile in Azure first — see docs/azure-scoring-profile-setup.md)
USE_SCORING_PROFILE=false
SCORING_PROFILE_NAME=oem-diagnosis-boost
SCORING_BOOST_TAGS=troubleshooting
SCORING_BOOST_PARAMETER_NAME=boostTags
# Required when the index default scoring profile uses tag boost (even if USE_SCORING_PROFILE=false)
SEND_SCORING_PARAMETERS=true

OPENAI_API_KEY=
# Vector length must match content_vector dimensions on your Azure Search index
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_TOKENS=128
EMBEDDING_BATCH_SIZE=100

# Directory for Azure DI markdown output (set empty to disable)
MARKDOWN_OUTPUT_DIR=extracted/markdown
# Skip Azure DI when {stem}.md already exists in MARKDOWN_OUTPUT_DIR
SKIP_EXTRACTION_IF_MARKDOWN_EXISTS=true
# Set true to always re-extract (or use CLI --force-extract)
FORCE_REEXTRACT=false
